#!/bin/sh
set -eu
if command -v gitleaks >/dev/null 2>&1; then
  scanner=gitleaks
elif [ -x "$HOME/.local/bin/gitleaks" ]; then
  scanner=$HOME/.local/bin/gitleaks
else
  echo 'Commit blocked: install Gitleaks to scan staged changes for secrets.' >&2
  exit 1
fi
exec "$scanner" git --pre-commit --staged --redact=100 --no-banner
